# Copy this file to .env.slack.local on the live OpsCenter Mac. The local file
# is ignored by git. On macOS, the publisher first checks Keychain service
# com.opscenter.slack-bot-token for account opscenter. SLACK_BOT_TOKEN remains
# available as a non-macOS fallback. Never use the Codex connector credential.
SLACK_OPSCENTER_ALERTS_ENABLED=false
SLACK_WHATSAPP_PHOTO_NOTIFICATIONS_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_OPSCENTER_BASE_URL=https://ops.junk-king.app

# Slack channels created for Junk King | Louisiana on 2026-08-07.
SLACK_OPS_COMMAND_CHANNEL_ID=C0BNMDJNYV9
SLACK_OPS_DISPATCH_CHANNEL_ID=C0BNRMD25AS
SLACK_OPS_FLEET_CHANNEL_ID=C0BNQ6J7LER
SLACK_OPS_FINANCE_CHANNEL_ID=C0BNVJR6HMX
SLACK_OPS_GROWTH_CHANNEL_ID=C0BNXBK8GTW
SLACK_OPS_DATA_HEALTH_CHANNEL_ID=C0BPN1FVCDN
# Defaults to #ops-dispatch when omitted.
SLACK_WHATSAPP_PHOTO_CHANNEL_ID=C0BNRMD25AS
