<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PYTHONDONTWRITEBYTECODE</key>
		<string>1</string>
	</dict>
	<key>KeepAlive</key>
	<false/>
	<key>Label</key>
	<string>com.opscenter.web-push</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>/Users/missioncontrol/opscenter-v2/opscenter/scripts/supervise-web-push.py</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/Users/missioncontrol/Library/Logs/OpsCenter/web-push.stderr.log</string>
	<key>StandardOutPath</key>
	<string>/Users/missioncontrol/Library/Logs/OpsCenter/web-push.stdout.log</string>
	<key>WorkingDirectory</key>
	<string>/Users/missioncontrol/opscenter-v2/opscenter</string>
</dict>
</plist>
