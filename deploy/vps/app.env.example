# Store the real file at /etc/opscenter/app.env with mode 0600.
# Never commit the real values.

# Required: generate with `openssl rand -base64 48`.
OPS_AUTH_SESSION_SECRET=replace-with-a-long-random-secret

# Required before public cutover. Cloudflare Access must protect ops.junk-king.app.
# This is the Access application audience tag, not the tunnel ID.
OPS_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
OPS_ACCESS_AUD=replace-with-cloudflare-access-audience

# Crew portal Access application.
OPS_CREW_HOSTNAME=crew.junk-king.app
OPS_CREW_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
OPS_CREW_ACCESS_AUD=replace-with-crew-access-audience
OPS_CREW_ROSTER_JSON=[]

# Free iPhone Shortcuts ingest. Use separate long random values for ingest and
# collector refresh access; never put either token in a URL.
OPS_SMS_WEBHOOK_HOSTNAME=hooks.junk-king.app

# WhatsApp truck-photo intake. Keep the access token in Keychain on Mission
# Control; these placeholders document the application-side configuration.
WHATSAPP_META_APP_SECRET_BASE64=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_TRUCK_PHONE_MAP_BASE64=
WHATSAPP_CONTEXT_MAX_AGE_MINUTES=10
WHATSAPP_GPS_MAX_AGE_MINUTES=30
WHATSAPP_MAX_JOB_DISTANCE_MILES=0.5
WHATSAPP_MINIMUM_JOB_MARGIN_MILES=0.15
JUNKWARE_SMS_INGEST_TOKEN=
JUNKWARE_SMS_REFRESH_TOKEN=

# Only needed for the route planner to write assignments back to JunkWare.
JUNKWARE_USERNAME=
JUNKWARE_PASSWORD=

# Optional integrations.
LINXUP_API_KEY=
GOOGLE_MAPS_ROUTES_API_KEY=
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
INTUIT_REDIRECT_URI=https://ops.junk-king.app/api/integrations/qbo/callback
INTUIT_ENVIRONMENT=production
QBO_SUPPORT_EMAIL=
QBO_PAYMENTS_ENABLED=false
QBO_PAYMENTS_ALLOW_LIVE_CHARGES=false
QBO_PAYMENTS_RECAPTCHA_SITE_KEY=
QBO_PAYMENTS_RECAPTCHA_SECRET=
QBO_PAYMENTS_MAX_AMOUNT=10000
QBO_PAYMENTS_AUDIT_DIR=

# SearchKings reporting. Keep credentials on the Mac collector; the VPS only
# reads the resulting snapshot and these matching thresholds.
SEARCHKINGS_CUSTOMER_ID=SKC1002034843
SEARCHKINGS_QUALIFIED_SCORE=3
SEARCHKINGS_LOST_AFTER_HOURS=72

# Health check considers data stale after this many seconds.
OPSCENTER_HEALTH_MAX_AGE_SECONDS=1200

# Optional OpsCenter Slack alerts. The live Mac collector normally owns these
# values because it runs the five-minute alert publisher.
SLACK_OPSCENTER_ALERTS_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_OPSCENTER_BASE_URL=https://ops.junk-king.app
SLACK_OPS_COMMAND_CHANNEL_ID=C0BNMDJNYV9
SLACK_OPS_DISPATCH_CHANNEL_ID=C0BNRMD25AS
SLACK_OPS_FLEET_CHANNEL_ID=C0BNQ6J7LER
SLACK_OPS_FINANCE_CHANNEL_ID=C0BNVJR6HMX
SLACK_OPS_GROWTH_CHANNEL_ID=C0BNXBK8GTW
SLACK_OPS_DATA_HEALTH_CHANNEL_ID=C0BPN1FVCDN
SLACK_JOBS_NO_CHANNEL_ID=C0BPRML654N
SLACK_JOBS_BR_CHANNEL_ID=C0BPQ30C8LD
SLACK_JOBS_NS_CHANNEL_ID=C0BPC9M5GLX
